// SRMIST Campus Knowledge Graph Seed Script (Regulations 2021 Unified Curricula)
// Constraints
CREATE CONSTRAINT course_code_unique IF NOT EXISTS FOR (c:Course) REQUIRE c.code IS UNIQUE;
CREATE CONSTRAINT program_id_unique IF NOT EXISTS FOR (p:Program) REQUIRE p.id IS UNIQUE;
CREATE CONSTRAINT faculty_id_unique IF NOT EXISTS FOR (f:FacultyMember) REQUIRE f.id IS UNIQUE;
CREATE CONSTRAINT room_id_unique IF NOT EXISTS FOR (r:Room) REQUIRE r.id IS UNIQUE;
CREATE CONSTRAINT building_code_unique IF NOT EXISTS FOR (b:Building) REQUIRE b.code IS UNIQUE;

// Buildings
MERGE (b:Building {code: 'TP'}) SET b.name = 'Tech Park', b.floors = 15, b.campus = 'Kattankulathur (KTR)';
MERGE (b:Building {code: 'TP2'}) SET b.name = 'Tech Park 2 (TP-2)', b.floors = 12, b.campus = 'Kattankulathur (KTR)';
MERGE (b:Building {code: 'UB'}) SET b.name = 'University Building', b.floors = 14, b.campus = 'Kattankulathur (KTR)';
MERGE (b:Building {code: 'BEL'}) SET b.name = 'Bioengineering Block', b.floors = 8, b.campus = 'Kattankulathur (KTR)';
MERGE (b:Building {code: 'MEB'}) SET b.name = 'Mechanical Engineering Block', b.floors = 6, b.campus = 'Kattankulathur (KTR)';
MERGE (b:Building {code: 'ESB'}) SET b.name = 'Electrical Sciences Block', b.floors = 7, b.campus = 'Kattankulathur (KTR)';
MERGE (b:Building {code: 'FMB'}) SET b.name = 'Faculty of Management Block', b.floors = 5, b.campus = 'Kattankulathur (KTR)';
MERGE (b:Building {code: 'SLB'}) SET b.name = 'School of Law Building', b.floors = 4, b.campus = 'Kattankulathur (KTR)';
MERGE (b:Building {code: 'MCB'}) SET b.name = 'Medical College Hospital Block', b.floors = 10, b.campus = 'Kattankulathur (KTR)';

// Sample Rooms
MERGE (r:Room {id: 'TP-101'}) SET r.room_number = 'TP-101', r.type = 'Smart Classroom', r.capacity = 50;
